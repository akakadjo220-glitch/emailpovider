# Copier en .env et renseigner. Ne jamais commiter de vraies valeurs.
PORT=3001

# Supabase (obligatoires) — la clé service_role ne doit exister que côté serveur
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sécurité HTTP
# Origines autorisées, séparées par des virgules (ex: https://babipass.com,https://www.babipass.com)
CORS_ORIGINS=
# Nombre de proxies devant le serveur (Coolify/Traefik = 1)
TRUST_PROXY_HOPS=1

# OTP : secret supplémentaire pour hacher les codes (par défaut : la clé service_role)
OTP_PEPPER=

# Didit (vérification d'identité)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# Secret de signature du webhook (console Didit > Webhooks)
DIDIT_WEBHOOK_SECRET=
DIDIT_CALLBACK_URL=https://babipass.com/organizer

# SMTP : mettre true une fois le certificat du serveur SMTP vérifié valide
SMTP_STRICT_TLS=false

# Paiements (phase 1a) : URL publique de ce serveur, utilisée dans les callbacks
# envoyés aux opérateurs (FeexPay, InTouch, PayDunya). Ex : https://api.babipass.com
PUBLIC_API_URL=
# Secret des jetons de callback (par défaut : la clé service_role)
PAYMENT_CALLBACK_SECRET=

# Phase 2 — rôle du processus : api | worker | all (défaut : all)
#   api    : API HTTP seulement, à multiplier derrière le proxy
#   worker : files d'attente + tâches planifiées (1 ou 2 instances)
PROCESS_ROLE=all
# Débit des files (valeurs par défaut)
QUEUE_BATCH=50
EMAIL_CONCURRENCY=5
WHATSAPP_CONCURRENCY=3
SMTP_MAX_PER_SECOND=10
# Limites de débit partagées en base ; « memory » = par instance (dev local)
RATE_LIMIT_STORE=postgres

# Phase 4 — pics de charge
# Salle d'attente : créations de commande par seconde et par événement (toutes instances)
CHECKOUT_MAX_PER_SECOND_PER_EVENT=50
# Créations de commande simultanées par instance
CHECKOUT_MAX_CONCURRENT=20
# Commandes par IP / 15 min (large : réseaux mobiles CGNAT)
CHECKOUT_MAX_PER_IP=300
# Réplica en lecture pour le catalogue public (facultatif)
SUPABASE_READ_URL=
SUPABASE_READ_KEY=
# Monitoring : /metrics exige Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=
# Alertes d'exploitation (paiements bloqués, e-mails en panne…), toutes les 5 min.
# Séparer plusieurs destinataires par des virgules. WhatsApp : numéro international sans +.
ALERT_EMAILS=
ALERT_WHATSAPP=
# Sentry (facultatif, nécessite npm i @sentry/node)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# NE JAMAIS mettre à true en production : faux opérateur de paiement pour les tests de charge
ALLOW_TEST_PAYMENTS=false

# Phase 5 — archivage des événements terminés (billets + commandes → schéma archive)
# Désactivé par défaut : activer après avoir lu docs/PHASE5_VOLUME.md
ARCHIVE_ENABLED=false
# Ancienneté minimale (jours après l'événement) ; minimum imposé : 30
ARCHIVE_AFTER_DAYS=365
